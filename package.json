{
  "name": "bb-plugin-power-mode",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Power Mode",
    "description": "Makes typing EPIC: particle explosions, editor and screen shake, combo counter, flying letters, lightning, and synth sound. Toggle from the sidebar footer.",
    "branding": {
      "icon": "Zap"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "betterwright": "^2.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.2",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:test": "node scripts/build-test-site.mjs",
    "test:unit": "vitest run",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:node": "node --test tests/*.test.mjs",
    "test": "npm run test:unit && npm run test:node && npm run test:browser",
    "test:achievements": "node --test tests/achievement*.test.mjs"
  }
}
